# --- Shared (web + api) ---
# Must be identical in both apps/web and services/api so the web app's proxy
# can verify JWTs issued by the API without an extra network call.
JWT_SECRET=change-me-in-production

# --- Web (apps/web) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only: used by Next.js Route Handlers and Server Components to call
# the API directly. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
API_BASE_URL=http://localhost:8000

# --- API (services/api) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mokman:mokman@localhost:5432/mokman
REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# Shared secret an external cron sends as the X-Cron-Secret header to
# POST /internal/maintenance/sla-check. Not a user JWT -- this call has
# no user session. Set up the actual cron schedule (recommended: every
# 15 minutes) in Railway's dashboard; it isn't checked into this repo.
SLA_CRON_SECRET=change-me-in-production

# Object storage (S3-compatible)
S3_ENDPOINT_URL=
S3_BUCKET=mokman-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# OTP / notifications (fill in during Phase 1 vendor selection)
OTP_SMS_PROVIDER_API_KEY=
OTP_EMAIL_PROVIDER_API_KEY=
