# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- API (services/api) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mokman:mokman@localhost:5432/mokman
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Object storage (S3-compatible)
S3_ENDPOINT_URL=
S3_BUCKET=mokman-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# OTP / notifications (fill in during Phase 1 vendor selection)
OTP_SMS_PROVIDER_API_KEY=
OTP_EMAIL_PROVIDER_API_KEY=
